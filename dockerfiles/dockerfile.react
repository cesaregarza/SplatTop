###############################
#         Base Image          #
###############################
FROM node:24.15.0@sha256:f22d6a1f082c02f292e86929b5b0442ac2e5eaf438a5dea9b1566601c3e05940 AS base

WORKDIR /app

RUN npm install --global npm@12.0.2

###############################
#    Install Dependencies     #
###############################
FROM base AS dependencies

COPY src/react_app/package*.json ./
# Use npm ci for clean, reproducible installs
RUN npm ci

###############################
#        Build Image          #
###############################
FROM dependencies AS build

ARG REACT_APP_VERSION
ENV REACT_APP_VERSION=$REACT_APP_VERSION

COPY src/react_app/src ./src
COPY src/react_app/public ./public
COPY src/react_app/index.html ./
COPY src/react_app/tailwind.config.js ./
COPY src/react_app/vite.config.mjs ./

RUN npm run build

###############################
#        Final Image          #
###############################
FROM nginx:1.30.4-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

COPY --from=build /app/build /usr/share/nginx/html

COPY src/react_app/custom-nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
